# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Panel (simple password auth for MVP)
NEXT_PUBLIC_ADMIN_PASSWORD=change-this-password-immediately

# WhatsApp Business Number (format: 39XXXXXXXXXX for Italy)
NEXT_PUBLIC_WHATSAPP_NUMBER=393XXXXXXXXX

# Google Maps Review Link (optional)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/your-review-link

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
