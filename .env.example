# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Admin Panel ──────────────────────────────────────────────────────────────
# Password per accedere a /admin — cambiala subito con qualcosa di sicuro
NEXT_PUBLIC_ADMIN_PASSWORD=cambia-questa-password-subito

# ─── Telegram Bot (GRATUITO — notifica ordini istantanea) ─────────────────────
# 1. Apri Telegram e cerca @BotFather
# 2. Scrivi /newbot e segui le istruzioni → ti darà il BOT_TOKEN
# 3. Apri la chat con il tuo bot e scrivi /start
# 4. Vai su https://api.telegram.org/bot<BOT_TOKEN>/getUpdates → copia "chat.id"
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ─── Email Resend (GRATUITO 3.000 email/mese) ─────────────────────────────────
# 1. Vai su resend.com → crea account gratuito
# 2. Settings → API Keys → crea una chiave
# 3. Aggiungi il tuo dominio oppure usa @resend.dev per test
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATION_EMAIL=info@vernaci.it
# Se non hai ancora un dominio verificato usa: onboarding@resend.dev
NOTIFICATION_FROM_EMAIL=ordini@vernaci.it

# ─── WhatsApp Business (numero gelateria, format: 39XXXXXXXXXX) ───────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=393XXXXXXXXX

# ─── Link Google Maps recensioni (opzionale) ──────────────────────────────────
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/your-review-link

# ─── URL App ──────────────────────────────────────────────────────────────────
# In locale lascia http://localhost:3000
# Su Vercel metti il tuo dominio: https://vernaci.it
NEXT_PUBLIC_APP_URL=http://localhost:3000
